{:paths ["src" "resources"]
 ;; 受注の判定そのものは技芸層にある（ADR-2607023000）。ongaku.rights /
 ;; ongaku.work / ongaku.commission が「持っている権利と要求された譲渡」を
 ;; 受け取って判定し、**何を持っているかは知らない** —— それを持つのが
 ;; この repo の resources/works.edn。
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/ongaku
        {:git/url "https://github.com/kotoba-lang/ongaku"
         :git/sha "cb88622101057f49e8380ba6b7dab6723d02f964"}}
 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev {:override-deps
        {io.github.kotoba-lang/ongaku {:local/root "../../kotoba-lang/ongaku"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
